# Development convenience only. Copy to .env.local and fill in.
#
# This is read ONLY by `npm run dev`. A production build (`npm run build`)
# strips it out, because this app deploys as static files and an inlined key
# would be readable by anyone who loads the page.
#
# For a deployed build, each operator pastes their own key into the form.
# Get a key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash, which is reliably available on a free
# key. Set to a newer model (e.g. gemini-3.8-flash) if your key has the quota —
# the newest Flash models have a 20-request free-tier limit and return 503 under
# load.
VITE_GEMINI_MODEL=
